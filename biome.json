{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": ["**", "!out", "!dist", "!release", "!**/*.md", "!pnpm-lock.yaml", "!pnpm-workspace.yaml"]
  },
  "formatter": {
    "lineEnding": "crlf",
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["src/renderer/src/icons/**"],
      "formatter": { "enabled": false }
    },
    {
      "includes": ["src/renderer/**", "src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/main/**", "electron", "node:*"],
                    "message": "Renderer code reaches Electron only through window.win95."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/main/**", "src/preload/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  { "group": ["**/renderer/**"], "message": "Main and preload never import renderer code." }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
